{
  "//": "Copy to appsettings.Testing.json and point DefaultConnection at a local PostgreSQL 16. That file is gitignored because the connection string is machine-local; the CI workflow writes its own copy (see .github/workflows/deploy.yml). Apply the migrations before running the suite: dotnet run --project Homassy.Migrator",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=homassy;Username=your_username;Password=your_password"
  },
  "Kratos": {
    "PublicUrl": "http://localhost:4433",
    "AdminUrl": "http://localhost:4434",
    "SessionCookieName": "ory_kratos_session",
    "WebhookSecret": "test-secret"
  },
  "ProductSettings": { "ExpiringSoonThresholdDays": 7 },
  "RateLimiting": {
    "GlobalMaxAttempts": "1000000",
    "GlobalWindowMinutes": "1",
    "EndpointMaxAttempts": "1000000",
    "EndpointWindowMinutes": "1"
  },
  "Cors": { "AllowedOrigins": [ "http://localhost:3000" ] },
  "Security": {
    "AccountLockout": { "MaxFailedAttempts": 5, "LockoutDurationMinutes": 15 }
  },
  "InternalApi": { "ApiKey": "test-internal-api-key" },
  "RegistrationEnabled": true
}
